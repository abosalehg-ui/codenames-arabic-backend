# انسخ هذا الملف إلى .env وعبّئ القيم الحقيقية (لا ترفع .env إلى git أبداً)
PORT=5000
NODE_ENV=production

# قاعدة البيانات اختيارية — بدونها يعمل الخادم كاملاً (بلا أرشفة الألعاب)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/codenames

# مطلوب في الإنتاج — يدعم أكثر من نطاق مفصولة بفواصل. غيابه مع NODE_ENV=production يوقف التشغيل.
FRONTEND_URL=https://abosalehg-ui.github.io

# نظام المستخدمين (/api/users) معطّل افتراضياً لأنه غير مستخدم من الواجهة.
# فعّله فقط عند الحاجة، ومعه JWT_SECRET طويل وعشوائي (مثلاً: openssl rand -base64 48)
ENABLE_AUTH_API=false
JWT_SECRET=change-me-to-a-long-random-string
